      "med": "420ms",
      "slow": "900ms"
    }
  },
  "shadowPhilosophy": "soft-elevation",
  "signatureElement": "The Plumbline: a WAAPI plumb bob that hangs true over the live account and swings on every verdict",
  "signatureObject": {
    "name": "THE PLUMBLINE",
    "thesis": "Gravity is the only judge: the line hangs true while the live Vultr account matches authority, and a verdict is a swing the account then has to survive.",
    "perSurface": {
      "landing": "hero plumb over one real replayed DENY and the payoff numbers",
      "console": "sidebar shell (ATTACK, MONITOR, CONTAIN, TRUST) with the plumb as the stage between engine authority and Vultr reality"
    }
  },
  "invariantPhrase": "The line hangs true.",
  "statusLegend": [
    {
      "color": "#30de97",
      "token": "ALLOW / GREEN",
      "meaning": "engine allowed it, or the second host read the account as matching authority"
    },
    {
      "color": "#fc4257",
      "token": "DENY / RED",
      "meaning": "the engine refused (the account did not move), or the verifier names an unauthorised resource"
    },
    {
      "color": "#f7b83d",
      "token": "ESCALATE / DEGRADED",
      "meaning": "a human decision is required, or a host is unreachable (the line goes ghost)"
    }
  ],
