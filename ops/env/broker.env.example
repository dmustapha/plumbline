# File: ops/env/broker.env.example
PLUMBLINE_DATA_DIR=/var/lib/plumbline
PLUMBLINE_SOCKET=/run/plumbline/broker.sock
PLUMBLINE_SANDBOX_BIND=172.17.0.1
PLUMBLINE_SANDBOX_PORT=7443
PLUMBLINE_SESSION_CEILING_USD=1.5
PLUMBLINE_GLOBAL_CAP_USD=10
PLUMBLINE_MAX_INSTANCES=4
PLUMBLINE_BOND_ENABLED=0
PLUMBLINE_BOND_USD=0.05
PLUMBLINE_BOND_BURN_USD=0.045
PLUMBLINE_REQUIRE_FLOOR_SIG=1
PLUMBLINE_VERIFIER_URL=https://__VERIFIER_HOST__
PLUMBLINE_LEASE_TTL_S=45
PLUMBLINE_BUCKET=plumbline-orders-db
PLUMBLINE_RANGE_API_URL=http://127.0.0.1:8080
PLUMBLINE_API_TOKEN=__SET_BY_BOOTSTRAP__
PLUMBLINE_ADMIN_TOKEN=__SET_BY_BOOTSTRAP__
PLUMBLINE_TASK_HMAC=__SET_BY_BOOTSTRAP__
PLUMBLINE_LEASE_SECRET=__SET_BY_BOOTSTRAP__
PLUMBLINE_POLICY_PUBKEY=__SET_BY_SIGN_POLICY_INIT__
VULTR_KEY_OBSERVER=__SET_BY_BOOTSTRAP__
VULTR_KEY_DEPLOYER=__SET_BY_BOOTSTRAP__
VULTR_KEY_NETWORK=__SET_BY_BOOTSTRAP__
VULTR_KEY_REGISTRY=__SET_BY_BOOTSTRAP__
VULTR_INFERENCE_API_KEY=__COPIED_FROM_OWNER_ENV__
VULTR_S3_HOST=ewr1.vultrobjects.com
VULTR_S3_ACCESS_KEY=__COPIED_FROM_OWNER_ENV__
VULTR_S3_SECRET_KEY=__COPIED_FROM_OWNER_ENV__
