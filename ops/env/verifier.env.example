# File: ops/env/verifier.env.example
# Only the view-only key and the lease secret (D-R6a). Mode 0600, owned by root, read by systemd before the process drops privileges.
PLUMBLINE_VERIFIER_HOST=127.0.0.1
PLUMBLINE_VERIFIER_PORT=8081
# a subscriptions_view key (billing at most); the verifier calls GET /account at boot and refuses to start if it has any other ACL
PLUMBLINE_VERIFIER_KEY=__SET_BY_BOOTSTRAP__
PLUMBLINE_LEASE_SECRET=__SET_BY_BOOTSTRAP__
PLUMBLINE_BROKER_PUBLIC_URL=https://__BROKER_HOST__
PLUMBLINE_LEDGER_EXPORT_PATH=/v1/ledger/export
PLUMBLINE_SHARED_DIR=/var/lib/plumbline-shared
PLUMBLINE_STATE_DIR=/var/lib/plumbline-verifier
PLUMBLINE_BASELINE_PATH=/etc/plumbline/baseline.json
# never below 3000 (the loader refuses)
PLUMBLINE_POLL_GAP_MS=3000
# the production floor the verifier re-runs the policy engine against; with a public key the detached signature must verify
PLUMBLINE_FLOOR_PATH=/opt/plumbline/app/policy/floor.yaml
PLUMBLINE_FLOOR_SIG_PATH=/opt/plumbline/app/policy/floor.yaml.sig
PLUMBLINE_POLICY_PUBKEY=__SET_BY_SIGN_POLICY_INIT__
# a lease heartbeat claiming a longer ttl_s is refused (1..120, the broker default is 120)
PLUMBLINE_LEASE_MAX_TTL_S=60
PLUMBLINE_EXPORT_MAX_AGE_S=60
# uid of plumbline-watchdog: watchdog-actions.jsonl is honoured only if owned by it (`id -u plumbline-watchdog`)
PLUMBLINE_WATCHDOG_UID=__SET_BY_BOOTSTRAP__
