# File: ops/env/runner.env.example
PLUMBLINE_RUNNER_TOKEN=__SET_BY_BOOTSTRAP__
PLUMBLINE_RUNNER_SOCKET=/run/plumbline/runner.sock
PLUMBLINE_SANDBOX_RUNTIME=
# relay (default, ADR-005) or socket (U-4 fallback: --network none plus one read-only mount of the dedicated sandbox socket directory)
PLUMBLINE_SANDBOX_TRANSPORT=relay
PLUMBLINE_SANDBOX_SOCKET_DIR=
