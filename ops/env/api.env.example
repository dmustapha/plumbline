# File: ops/env/api.env.example
PLUMBLINE_API_HOST=127.0.0.1
PLUMBLINE_API_PORT=8080
PLUMBLINE_SOCKET=/run/plumbline/broker.sock
PLUMBLINE_RUNNER_SOCKET=/run/plumbline/runner.sock
PLUMBLINE_API_TOKEN=__SET_BY_BOOTSTRAP__
PLUMBLINE_RUNNER_TOKEN=__SET_BY_BOOTSTRAP__
PLUMBLINE_VERIFIER_URL=https://__VERIFIER_HOST__
PLUMBLINE_EVIDENCE_DIR=/opt/plumbline/app/evidence
PLUMBLINE_PUBLIC_DIR=/opt/plumbline/app/apps/range-api/public
PLUMBLINE_KEY_EXPIRY_ISO=2026-11-20T00:00:00Z
PLUMBLINE_DEMO_CAPS=0
PLUMBLINE_MAX_IN_FLIGHT=4
