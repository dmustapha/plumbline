# File: ops/env/watchdog.env.example
# Only the watchdog's own scoped key (provisioning + firewall, IP-locked to VM 2) and the public policy key (D-R6a). Mode 0600, owned by root.
# The watchdog refuses to boot with the verifier key, the lease secret or the owner key present, and (AG4-VER-7) if GET /account shows any ACL
# other than provisioning and firewall.
PLUMBLINE_WATCHDOG_KEY=__SET_BY_BOOTSTRAP__
PLUMBLINE_POLICY_PUBKEY=__SET_BY_SIGN_POLICY_INIT__
PLUMBLINE_SHARED_DIR=/var/lib/plumbline-shared
PLUMBLINE_FLOOR_PATH=/opt/plumbline/app/policy/floor.yaml
PLUMBLINE_FLOOR_SIG_PATH=/opt/plumbline/app/policy/floor.yaml.sig
# ids in this manifest are never deleted, whatever their label (must be readable by plumbline-watchdog, e.g. root:plumbline-vm2 0640)
PLUMBLINE_BASELINE_PATH=/etc/plumbline/baseline.json
# uid of plumbline-verifier (`id -u plumbline-verifier`): lease.json is trusted only if owned by it. A placeholder fails the boot.
PLUMBLINE_VERIFIER_UID=__SET_BY_BOOTSTRAP__
# a missing lease counts as lapsed after this many seconds from watchdog start (10..900)
PLUMBLINE_LEASE_GRACE_S=120
# 1 (or anything but 0) = dry-run: reports would_delete in watchdog-status.json and deletes nothing. Only an explicit 0 goes live.
PLUMBLINE_WATCHDOG_DRY_RUN=1
# 500..30000
PLUMBLINE_WATCHDOG_TICK_MS=2000
