# File: ops/Caddyfile.broker
{$PLUMBLINE_HOST}, plumbline.108-61-70-169.sslip.io {
	# LIVE FINDING: compressing text/event-stream makes Caddy buffer the stream; browsers and Node fetch send Accept-Encoding, so SSE must not be encoded.
	@notsse not path /api/stream/*
	encode @notsse zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	request_body {
		max_size 80KB
	}
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
